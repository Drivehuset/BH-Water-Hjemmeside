{
  "name": "B&H Water Version 2",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Version 2 – privat forhåndsvisning",
      "onAutoForward": "openPreview",
      "visibility": "private"
    }
  },
  "postStartCommand": "nohup python3 -m http.server 8000 --bind 0.0.0.0 >/tmp/bhwater-preview.log 2>&1 &"
}